# Copy to apps/api/.env. Generate secrets with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://marketplace:marketplace@localhost:5432/marketplace
# Supabase: use the direct Postgres address (port 5432) as DATABASE_URL while developing.
# On Render, DATABASE_URL can be the pooler and DIRECT_URL the direct address. If DIRECT_URL is empty, the server uses DATABASE_URL.
DIRECT_URL=
# Wall photos. Leave empty until a Firebase Storage bucket exists. The private key keeps its \n line breaks.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_STORAGE_BUCKET=
JWT_ACCESS_SECRET=
PII_ENCRYPTION_KEY=
CORS_ORIGIN=http://localhost:3000
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
MFA_CHALLENGE_TTL_SECONDS=300
GOOGLE_CLIENT_ID=
APPLE_CLIENT_ID=
APP_WEB_URL=http://localhost:3000
# Set only when this API process also serves the shop pages. Leave empty in local development.
WEB_ROOT=
# A real mailbox. Gmail: smtp.gmail.com, port 465, an app password as SMTP_PASS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
